  "privacyEmailSubject": "Pray in Time - Privacy Inquiry",
  "privacyShieldTitle": "Your Privacy is Sacred",
  "privacyShieldDesc": "Pray in Time operates completely on-device without tracking, ads, or external data collection.",
  "privacyBadgeOffline": "Offline Ready",
  "privacyBadgeNoAccounts": "No Accounts",
  "privacyBadgeZeroAds": "Zero Ads",
  "privacyOverviewTitle": "Overview",
  "privacyOverviewContent": "Welcome to Pray in Time. Your privacy is of paramount importance to us. This Privacy Policy explains how our application handles your information. In short: Pray in Time is built on a privacy-first, on-device architecture. We do not operate external servers, and we never collect, sell, or share your personal data.",
  "privacyLocationTitle": "Location Data & City Detection",
  "privacyLocationContent": "To calculate accurate Islamic prayer times (Fajr, Sunrise, Dhuhr, Asr, Maghrib, and Isha) for your region, the application requests foreground access to your device's location.\n\n• On-Device Calculation: Your GPS coordinates are processed locally using astronomical algorithms and cached on your device for instant offline access.\n• City Name Display: Your device's built-in OS geocoder is used to display your city/region name in the app and save it locally.\n• No Background Location Tracking: Location is never tracked in the background or sent to our own servers.",
  "privacyAlarmsTitle": "Alarms & Foreground Adhan Audio",
  "privacyAlarmsContent": "Pray in Time schedules prayer alarms up to 14 days ahead directly on your device so you never miss a prayer—even when the app is closed.\n\n• Native Exact Alarms: Scheduled locally through Android AlarmManager (AlarmClock) with automatic restoration after device restarts.\n• Foreground Audio Service: When prayer time enters, a temporary foreground media service runs solely to play the full Adhan audio and display a \"Stop Adhan\" notification control, then stops automatically.\n• Zero Push Servers: No cloud push services or external servers are used to trigger alerts.",
  "privacyStorageTitle": "Preferences & Local Storage",
  "privacyStorageContent": "Data such as your onboarding status, app language, last detected coordinates, city name, scheduled local alarm times, calculation method, and juristic preferences are stored strictly on your device via SharedPreferences.\n\n• No user account or sign-up is required.\n• All locally stored data is permanently erased whenever you clear app data or uninstall the app.",
  "privacyThirdPartyTitle": "Third-Party Services & Tracking",
  "privacyThirdPartyContent": "Pray in Time does NOT include third-party analytics SDKs, advertising networks, or data brokers. We do not track your behavior, device identifiers, or usage habits.",
  "permissionsUsedHeader": "PERMISSIONS USED",
  "permLocationTitle": "Location (Foreground GPS)",
  "permLocationDesc": "Used to calculate prayer schedules locally and detect your city name.",
  "permNotificationsTitle": "Notifications",
  "permNotificationsDesc": "Alerts you when prayer time enters and provides the \"Stop Adhan\" button.",
  "permExactAlarmsTitle": "Exact Alarms",
  "permExactAlarmsDesc": "Triggers Adhan alarms accurately down to the second, even in Doze mode.",
  "permForegroundMediaTitle": "Foreground Media Playback & Wake Lock",
  "permForegroundMediaDesc": "Plays the full Adhan audio reliably when the screen is locked or the app is closed.",
  "permBootTitle": "Boot Completed",
  "permBootDesc": "Automatically restores your scheduled local prayer alarms after a phone restart.",
